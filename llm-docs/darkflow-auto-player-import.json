    "functions": {
      "scopes": {
        "ws://tdome.nukefire.org:4000": {
          "functions": [
            {
              "id": "auto-loop-function-tick",
              "enabled": true,
              "name": "tick",
              "description": "Main state-machine tick for the automation timer.",
              "group": "Auto Loop",
              "script": "set $auto_hp_pct = ($gmcp_char_vitals_hp * 100) / $gmcp_char_vitals_mhp\nif $auto_mode == paused\n  show Auto loop is paused.\nelseif $auto_hp_pct <= $auto_panic_pct\n  call panic\nelseif $auto_in_combat == 1\n  call combat_tick\nelseif $auto_mode == recovering\n  call recovery_tick\nelseif $auto_mode == hunting\n  call hunt_tick\nelse\n  show Unknown auto mode $auto_mode; pausing.\n  set $auto_mode = paused\n  stop_timer main_loop\nend"
            },
            {
              "id": "auto-loop-function-panic",
              "enabled": true,
              "name": "panic",
              "description": "Emergency stop behavior when health crosses the panic threshold.",
              "group": "Auto Loop",
              "script": "set $auto_mode = paused\nset $auto_in_combat = 0\nset $auto_last_action = panic\nstop_timer main_loop\nsend flee\nshow Auto panic fired at $auto_hp_pct% hp. Timer stopped."
            },
            {
              "id": "auto-loop-function-combat-tick",
              "enabled": true,
              "name": "combat_tick",
              "description": "Per-tick behavior while combat is active.",
              "group": "Auto Loop",
              "script": "set $auto_last_action = combat\nif $auto_hp_pct <= $auto_heal_pct\n  send $auto_heal_command\nelse\n  send $auto_combat_command $auto_target\nend"
            },
            {
              "id": "auto-loop-function-recovery-tick",
              "enabled": true,
              "name": "recovery_tick",
              "description": "Rest until health reaches the configured rest threshold.",
              "group": "Auto Loop",
              "script": "set $auto_last_action = recovering\nif $auto_hp_pct >= $auto_rest_pct\n  set $auto_mode = hunting\n  set $auto_last_action = recovery_done\n  send $auto_stand_command\nelse\n  send $auto_rest_command\nend"
            },
            {
              "id": "auto-loop-function-hunt-tick",
              "enabled": true,
              "name": "hunt_tick",
              "description": "Look for the target, recover if needed, otherwise advance the route.",
              "group": "Auto Loop",
              "script": "if $auto_hp_pct <= $auto_heal_pct\n  set $auto_mode = recovering\n  set $auto_last_action = low_hp_recover\n  send $auto_rest_command\nelse\n  call find_or_move\nend"
            },
            {
              "id": "auto-loop-function-find-or-move",
              "enabled": true,
              "name": "find_or_move",
              "description": "Alternate between trying the target and moving along the configured route.",
              "group": "Auto Loop",
              "script": "if $auto_last_action == seek\n  call move_route\n  set $auto_last_action = move\nelse\n  send $auto_combat_command $auto_target\n  set $auto_last_action = seek\nend"
            },
            {
              "id": "auto-loop-function-move-route",
              "enabled": true,
              "name": "move_route",
              "description": "Move through auto_route_0 through auto_route_7 according to auto_route_size.",
              "group": "Auto Loop",
              "script": "if $auto_route_index >= $auto_route_size\n  set $auto_route_index = 0\nend\nif $auto_route_index == 0\n  if not_empty $auto_route_0\n    send $auto_route_0\n  else\n    show Auto auto_route_0 is empty.\n  end\nelseif $auto_route_index == 1\n  if not_empty $auto_route_1\n    send $auto_route_1\n  else\n    show Auto auto_route_1 is empty.\n  end\nelseif $auto_route_index == 2\n  if not_empty $auto_route_2\n    send $auto_route_2\n  else\n    show Auto auto_route_2 is empty.\n  end\nelseif $auto_route_index == 3\n  if not_empty $auto_route_3\n    send $auto_route_3\n  else\n    show Auto auto_route_3 is empty.\n  end\nelseif $auto_route_index == 4\n  if not_empty $auto_route_4\n    send $auto_route_4\n  else\n    show Auto auto_route_4 is empty.\n  end\nelseif $auto_route_index == 5\n  if not_empty $auto_route_5\n    send $auto_route_5\n  else\n    show Auto auto_route_5 is empty.\n  end\nelseif $auto_route_index == 6\n  if not_empty $auto_route_6\n    send $auto_route_6\n  else\n    show Auto auto_route_6 is empty.\n  end\nelseif $auto_route_index == 7\n  if not_empty $auto_route_7\n    send $auto_route_7\n  else\n    show Auto auto_route_7 is empty.\n  end\nelse\n  set $auto_route_index = 0\nend\nset $auto_route_index = $auto_route_index + 1\nif $auto_route_index >= $auto_route_size\n  set $auto_route_index = 0\nend"
            }
          ]
        }
      }

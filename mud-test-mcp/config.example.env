# Copy to .env and fill in only what you need. .env is gitignored.
#
# This server is a generic MUD relay: clients pass the target host/port/
# username/password as arguments to mud_connect. EVERYTHING below is OPTIONAL.
#   - In a multi-tenant deployment, leave the MUD_* vars blank; each connection
#     supplies its own target.
#   - For a single-tenant/local setup you can set defaults here so callers can
#     omit them (and the CLI, which always uses these).

# --- Optional default target (single-tenant convenience) ---
# MUD_HOST=127.0.0.1
# MUD_PORT=4242
# MUD_TLS=0
# MUD_CHARACTER=
# MUD_PASSWORD=
# (MUD_TEST_CHAR / MUD_TEST_PASS are still accepted as aliases.)

# --- Optional login-prompt overrides (if a MUD differs from the defaults) ---
# MUD_NAME_PROMPT=by what name|what is your name|enter your name|login:
# MUD_PASSWORD_PROMPT=password|passphrase
# MUD_CLIENT_NAME=Mudlet

# --- Optional framing tuning (milliseconds) ---
# MUD_QUIET_MS=250
# MUD_TIMEOUT_MS=3000

# --- Remote (Streamable HTTP) transport; only used with `--http` ---
# MCP_HTTP_HOST=127.0.0.1          # bind address; keep 127.0.0.1 behind a tunnel/proxy
# MCP_HTTP_PORT=7423
# MCP_PATH=/mcp                     # set to a long random path for a "hidden URL", e.g. /mcp/8f3c1d...
# MCP_AUTH_TOKEN=                   # if UNSET the endpoint is wide open; if set, clients must send Authorization: Bearer <token>
